---
import type { LandingContent, Locale } from '../content/locales';

interface Props {
  content: LandingContent;
  locale: Locale;
}

const { content, locale } = Astro.props;

const growthCopy = {
  en: {
    title: 'Start where you are. Grow as far as you can.',
    body: 'A clear journey for career switchers, salespeople, graduates, and aspiring leaders.',
    stages: ['Learn', 'Perform', 'Lead'],
  },
  bm: {
    title: 'Mulakan di mana anda berada. Maju sejauh yang anda mampu.',
    body: 'Laluan jelas untuk mereka yang bertukar kerjaya, jurujual, graduan dan bakal pemimpin.',
    stages: ['Belajar', 'Berprestasi', 'Memimpin'],
  },
  zh: {
    title: '从你所在的位置开始，向更高的目标成长。',
    body: '为转职人士、销售人员、毕业生和未来领导者提供清晰的成长路径。',
    stages: ['学习', '实践', '领导'],
  },
} as const;

const growth = growthCopy[locale];
---

<section class="hero career-hero" data-career-hero>
  <div class="hero-copy">
    <p class="eyebrow">{content.hero.eyebrow}</p>
    <h1 data-motion="hero-title">{content.hero.title}</h1>
    <p class="lede">{content.hero.subtitle}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#apply">{content.hero.primaryCta}</a>
      <a class="button button-secondary" href="#support">{content.hero.secondaryCta}</a>
    </div>
  </div>

  <aside class="hero-growth-panel glass-surface glass-interactive" data-motion="hero-image" aria-labelledby="hero-growth-title">
    <h2 id="hero-growth-title">{growth.title}</h2>
    <p>{growth.body}</p>
    <ol class="hero-stage-list">
      {growth.stages.map((stage, index) => (
        <li data-hero-stage>
          <strong>{stage}</strong>
          <span>{content.progression.steps[index]}</span>
        </li>
      ))}
    </ol>
  </aside>
</section>
