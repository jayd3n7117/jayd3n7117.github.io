---
import type { LandingContent, Locale } from '../content/locales';
import type { SupportingPageKey } from '../content/pages';

interface Props {
  locale: Locale;
  content: LandingContent;
  supportingPageKey?: SupportingPageKey;
}

const { locale, content, supportingPageKey } = Astro.props;
const homeSection = (id: string) => supportingPageKey ? `/${locale}/#${id}` : `#${id}`;

const languageLinks = [
  { locale: 'en', label: 'English' },
  { locale: 'bm', label: 'Bahasa Malaysia' },
  { locale: 'zh', label: '中文' },
] as const;
---

<header class="site-header">
  <div class="shell section-inner header-inner glass-surface">
    <a class="wordmark" href={`/${locale}/`} aria-label={content.chrome.homeLabel}>
      <span aria-hidden="true">COWAY</span>
    </a>

    <nav class="desktop-navigation" aria-label={content.chrome.primaryNavigationLabel}>
      <ul class="primary-navigation">
        <li><a href={homeSection('opportunity')}>{content.nav.opportunity}</a></li>
        <li><a href={homeSection('support')}>{content.nav.support}</a></li>
        <li><a href={homeSection('growth')}>{content.nav.culture}</a></li>
        <li><a href={homeSection('faq')}>{content.nav.faq}</a></li>
        <li><a href={homeSection('apply')}>{content.nav.apply}</a></li>
      </ul>
    </nav>

    <details class="mobile-navigation" data-header-disclosure="navigation">
      <summary>{content.nav.menu}</summary>
      <nav aria-label={content.nav.menu}>
        <ul>
          <li><a href={homeSection('opportunity')}>{content.nav.opportunity}</a></li>
          <li><a href={homeSection('support')}>{content.nav.support}</a></li>
          <li><a href={homeSection('growth')}>{content.nav.culture}</a></li>
          <li><a href={homeSection('faq')}>{content.nav.faq}</a></li>
          <li><a href={homeSection('apply')}>{content.nav.apply}</a></li>
        </ul>
      </nav>
    </details>

    <div class="header-actions">
      <details class="language-menu" data-header-disclosure="language">
        <summary aria-label={`${content.nav.language}: ${content.meta.language}`}>
          {content.meta.language}
        </summary>
        <ul>
          {
            languageLinks.map((language) => (
              <li>
                <a
                  href={supportingPageKey && language.locale !== 'bm'
                    ? `/${language.locale}/${supportingPageKey}/`
                    : `/${language.locale}/`}
                  data-locale-link
                  aria-current={language.locale === locale ? 'page' : undefined}
                >
                  {language.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a class="button button-accent" href={homeSection('apply')}>{content.nav.apply}</a>
    </div>
  </div>
</header>
