---
import type { LandingContent } from '../content/locales';

interface Props {
  content: LandingContent;
}

const { content } = Astro.props;
---
<section id="support" class="section support-section" data-reveal-group>
  <header class="section-heading support-heading" data-reveal>
    <p class="eyebrow">{content.nav.support}</p>
    <h2>{content.support.title}</h2>
    <p>{content.support.intro}</p>
  </header>
  <div class="support-grid">
    {content.support.items.map((item, index) => (
      <article class={`support-item support-item-${(index % 3) + 1}`} data-reveal>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </article>
    ))}
  </div>
</section>
