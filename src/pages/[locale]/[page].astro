---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPage from '../../components/ContentPage.astro';
import {
  getSupportingPage,
  supportingPageKeys,
  type SupportingLocale,
  type SupportingPageKey,
} from '../../content/pages';
import '../../styles/content-page.css';
import { buildSupportingPageStructuredData } from '../../content/structured-data';

export function getStaticPaths() {
  return (['en', 'zh'] as const).flatMap((locale) =>
    supportingPageKeys.map((page) => ({
      params: { locale, page },
      props: { locale, page },
    })),
  );
}

interface Props {
  locale: SupportingLocale;
  page: SupportingPageKey;
}

const { locale, page } = Astro.props;
const content = getSupportingPage(locale, page);
const structuredData = buildSupportingPageStructuredData(
  locale,
  page,
  content,
  Astro.site ?? new URL(Astro.url.origin),
);
---

<BaseLayout {locale} meta={content.meta} pathKey={page} {structuredData}>
  <ContentPage {locale} pageKey={page} {content} />
</BaseLayout>
