---
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getContent, type LandingContent, type Locale } from '../content/locales';
import type { SupportingPageKey } from '../content/pages';
import { getSeo } from '../content/seo';
import '../styles/global.css';

interface Props {
  locale: Locale;
  content?: LandingContent;
  meta?: Pick<LandingContent['meta'], 'title' | 'description'>;
  pathKey?: SupportingPageKey;
}

const { locale, pathKey } = Astro.props;
const content = Astro.props.content ?? getContent(locale);
const meta = Astro.props.meta ?? content.meta;
const seo = getSeo(locale, Astro.site ?? new URL(Astro.url.origin), pathKey);
---

<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={seo.canonical} />
    {
      Object.entries(seo.alternates).map(([lang, href]) => (
        <link rel="alternate" hreflang={lang} href={href} />
      ))
    }
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{content.chrome.skipLink}</a>
    <Header {locale} {content} supportingPageKey={pathKey} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer {locale} {content} />
    <AnalyticsConsent {content} />
    <script>
      import '../scripts/navigation';
      import '../scripts/motion';
    </script>
  </body>
</html>
